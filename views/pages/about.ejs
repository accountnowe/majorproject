<%- layout("/layouts/boilerplate") %>

    <div class="row pt-5 pb-5">
        <div class="col-lg-6 offset-lg-3 text-center">
            <h5 class="text-uppercase tracking-widest text-muted mb-3" style="letter-spacing: 3px; font-weight: 700;">
                Our Story</h5>
            <h1 class="display-4 font-weight-bold mb-4" style="letter-spacing: -2px;">Elevating the Way You Travel</h1>
            <p class="lead text-muted mb-5">Wanderlust was born out of a simple idea: that every journey should be as
                unique as the traveler. We don't just provide stays; we provide gateways to culture, community, and
                comfort.</p>
        </div>
    </div>

    <div class="row mb-5 py-5 border-top border-bottom">
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-house-chimney-window mb-3 text-primary" style="font-size: 2.5rem;"></i>
            <h4 class="font-weight-bold">Handpicked Selection</h4>
            <p class="text-muted">Every listing is vetted for quality, style, and that special 'something'.</p>
        </div>
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-earth-americas mb-3 text-primary" style="font-size: 2.5rem;"></i>
            <h4 class="font-weight-bold">Global Reach</h4>
            <p class="text-muted">From downtown lofts to secluded islands, we connect you to the world.</p>
        </div>
        <div class="col-md-4 text-center">
            <i class="fa-solid fa-shield-heart mb-3 text-primary" style="font-size: 2.5rem;"></i>
            <h4 class="font-weight-bold">Trusted Security</h4>
            <p class="text-muted">Your safety and privacy are our highest priorities at Wanderlust.</p>
        </div>
    </div>

    <div class="row pt-5 align-items-center">
        <div class="col-md-6">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1200"
                class="img-fluid rounded-4 shadow-lg mb-4" style="border-radius: 24px;" alt="The Team">
        </div>
        <div class="col-md-6 pl-md-5">
            <h2 class="font-weight-bold mb-4">The Team Behind the Magic</h2>
            <p class="text-muted">We're a group of travelers, designers, and engineers dedicated to making travel more
                accessible and inspiring. We believe in the power of shared spaces to create lifelong memories.</p>
            <a href="/listings" class="btn btn-stylish mt-3">Join Our Community</a>
        </div>
    </div>